# 複製為 .env 之後按需要修改（docker compose 會自動讀取）。.env 已被 .gitignore 排除，唔好提交。
# 所有項目都係可選；唔建立 .env 時 compose.yaml 內嘅預設值同下面一樣。

# Host 上綁定嘅位址。預設只畀本機存取；admin endpoints 冇認證，唔好喺共用網絡上改成 0.0.0.0。
BIND_ADDRESS=127.0.0.1

# Host 上對外嘅 port（container 內部固定係 backend 5080、frontend 8080）。
BACKEND_HOST_PORT=5080
FRONTEND_HOST_PORT=8080

# 單次 CSV export 最多資料行數（1–100000）；超限會拒絕，唔截斷。
EXPORT_MAX_ROWS=10000

# Frontend 輪詢 backend 嘅間隔（毫秒，250–60000）。喺 build 時寫入 bundle，改咗要 docker compose up --build。
VITE_POLL_INTERVAL_MS=1000
