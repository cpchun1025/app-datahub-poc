<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>DataHub.Api</RootNamespace>
    <AssemblyName>DataHub.Api</AssemblyName>
    <!-- 本機 dotnet run / Visual Studio F5 嘅固定開發 port 見 Properties/launchSettings.json -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <!-- 預設 checkpoint 目錄 data/checkpoints 係執行期資料：唔好被 Web SDK 當 Content 帶入 publish 輸出。 -->
    <Content Remove="data\**" />
    <None Remove="data\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataHub.Api.Tests" />
  </ItemGroup>

</Project>
