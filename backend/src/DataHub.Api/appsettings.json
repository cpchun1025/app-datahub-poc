{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataHub": {
    "UseMockSources": true,
    "Snapshot": {
      "IntervalHours": 168,
      "RetryInitialDelaySeconds": 1,
      "RetryMaxDelaySeconds": 15
    },
    "Checkpoint": {
      "Enabled": true,
      "Directory": "data/checkpoints",
      "FileName": "checkpoint.json",
      "IntervalSeconds": 30,
      "SaveOnShutdown": true
    },
    "Freshness": {
      "StaleAfterSeconds": 30
    },
    "Api": {
      "DefaultPageSize": 100,
      "MaxPageSize": 500,
      "ExportMaxRows": 10000,
      "AdminEnabled": true,
      "SwaggerUiEnabled": false
    },
    "Mock": {
      "Sources": [
        {
          "SourceId": "mock-stream-a",
          "DisplayName": "Mock Stream A (simulated)",
          "Kind": "Streaming",
          "InstrumentCount": 2000,
          "UpdateIntervalMs": 250,
          "UpdatesPerTick": 25,
          "SnapshotLatencyMs": 400,
          "Currency": "USD",
          "PriceDecimals": 4,
          "MaxMovePercent": 0.4,
          "MembershipChangeProbability": 0.0002,
          "Seed": 11
        },
        {
          "SourceId": "mock-stream-b",
          "DisplayName": "Mock Stream B (simulated)",
          "Kind": "Streaming",
          "InstrumentCount": 1500,
          "UpdateIntervalMs": 400,
          "UpdatesPerTick": 15,
          "SnapshotLatencyMs": 300,
          "Currency": "HKD",
          "PriceDecimals": 2,
          "MaxMovePercent": 0.6,
          "MembershipChangeProbability": 0.0002,
          "Seed": 22
        },
        {
          "SourceId": "mock-api-c",
          "DisplayName": "Mock API C (simulated)",
          "Kind": "Polling",
          "InstrumentCount": 800,
          "UpdateIntervalMs": 1000,
          "UpdatesPerTick": 40,
          "PollIntervalSeconds": 5,
          "SnapshotLatencyMs": 200,
          "Currency": "EUR",
          "PriceDecimals": 3,
          "MaxMovePercent": 0.8,
          "MembershipChangeProbability": 0.0002,
          "Seed": 33
        }
      ]
    }
  }
}
