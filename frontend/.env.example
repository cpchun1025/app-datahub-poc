# 複製成 .env.local 之後按需要修改（*.local 已經被 git 忽略）。
# 所有 VITE_* 變數會喺 build 時寫入 bundle，唔可以放任何 secret。

# UI 向 backend 重新讀取資料嘅間隔（毫秒）。範圍 250 – 60000：超出範圍會被限制到邊界，唔係數字就回退到 1000。
VITE_POLL_INTERVAL_MS=1000

# 留空 = browser 打同源嘅 /api（開發時由 Vite proxy 轉發，Docker 時由 nginx 轉發），唔需要 CORS。
# 如果要 browser 直接打 backend，填 http://localhost:5080（backend Development 設定已允許 http://localhost:5173）。
VITE_API_BASE_URL=

# 只影響 `npm run dev`／`npm run preview` 嘅 proxy 目標，唔會寫入 bundle。
DATAHUB_DEV_PROXY_TARGET=http://localhost:5080
