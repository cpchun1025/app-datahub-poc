# 由 /docker-entrypoint.d/20-envsubst-on-templates.sh 喺 container 啟動時展開。
# 只會替換已定義嘅環境變數（BACKEND_UPSTREAM、NGINX_LOCAL_RESOLVERS 等），
# nginx 自己嘅變數（例如 host、uri）會原樣保留。

# 用 DNS 喺 request 時先解析 backend。NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 令 entrypoint 由 /etc/resolv.conf 取得 resolver，
# 喺 Compose 網絡內即係 Docker 內置 DNS。咁 backend 遲啲起身、重建或者 IP 改變，nginx 都唔使重啟，
# 亦唔會因為啟動時解析唔到 hostname 而直接 crash。
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/security-headers.conf;

    # 只確認 nginx 本身可用；唔檢查 backend，否則 backend 暫時停咗會令 UI container 都變成 unhealthy，睇唔到 disconnected 畫面。
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Browser 只打同源 /api；backend 喺 container 內部嘅位置只會出現喺呢度。
    # 用變數做 proxy_pass 先會喺 request 時經 resolver 解析；冇 URI 部分，所以原本嘅 path 同 query string 會原樣轉發。
    location /api/ {
        set $backend_upstream "${BACKEND_UPSTREAM}";
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;

        add_header Cache-Control "no-store" always;
        include /etc/nginx/security-headers.conf;
    }

    # Vite 輸出嘅檔名帶 content hash，可以長期 cache。
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # SPA fallback；index.html 唔可以長期 cache，否則重新部署後會載入舊嘅 asset 檔名。
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
        try_files $uri /index.html;
    }
}
